# LLM
OPENROUTER_API_KEY=sk-or-v1-...
LLM_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# App environment — set to "production" to disable /docs and /openapi.json
APP_ENV=development

# API security — REQUIRED in production: change all default values below
API_KEY=change-me-in-production
# ALLOWED_ORIGINS must be set to your production domain(s), e.g. https://rag.example.com
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_INGEST=5/minute
# Set to 1 when behind a reverse proxy (Nginx/Caddy), higher for multiple proxy hops
TRUSTED_PROXIES=0

# Server workers — set to 4 (or 2*CPU+1) in production
WORKERS=1

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001

# RAG tuning
MAX_CHUNK_SIZE=512
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
MAX_UPLOAD_SIZE_MB=50

# Logging — use "warning" in production to reduce noise
LOG_LEVEL=info

# Persistent session memory (optional — uses in-memory if not set)
# POSTGRES_DSN must use a strong password in production (see POSTGRES_PASSWORD below)
POSTGRES_DSN=postgresql://rag:change-me-in-production@localhost:5432/rag
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10

# Database password injected into docker-compose — REQUIRED in production
POSTGRES_PASSWORD=change-me-in-production

# Grafana admin password — REQUIRED in production
GRAFANA_ADMIN_PASSWORD=change-me-in-production

# URL ingestion security (optional — comma-separated allowed domains, empty = restricted to public only)
ALLOWED_URL_DOMAINS=
