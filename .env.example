# LLM
OPENROUTER_API_KEY=sk-or-v1-...
LLM_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# API security
API_KEY=change-me-in-production
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_INGEST=5/minute
TRUSTED_PROXIES=0

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001

# RAG tuning
MAX_CHUNK_SIZE=512
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
MAX_UPLOAD_SIZE_MB=50

# Logging
LOG_LEVEL=info

# Persistent session memory (optional — uses in-memory if not set)
POSTGRES_DSN=postgresql://rag:rag@localhost:5432/rag
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10

# URL ingestion security (optional — comma-separated allowed domains, empty = restricted to public only)
ALLOWED_URL_DOMAINS=
